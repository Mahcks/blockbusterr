    <!-- Collected Shows Card -->
    <div class="bg-slate-800/50 backdrop-blur rounded-lg border border-slate-700 overflow-hidden">
      <div class="bg-gradient-to-r from-teal-900/50 to-slate-800/50 p-4 border-b border-slate-700">
        <h3 class="text-xl font-semibold text-slate-100 flex items-center">
          <svg class="w-6 h-6 mr-2 text-teal-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"></path>
          </svg>
          Collected Shows
          <span class="ml-auto px-2 py-1 text-xs font-semibold rounded-full {{if .Config.Jobs.CollectedShows.Enabled}}bg-green-500/20 text-green-400{{else}}bg-slate-600/50 text-slate-400{{end}}">
            {{if .Config.Jobs.CollectedShows.Enabled}}ENABLED{{else}}DISABLED{{end}}
          </span>
        </h3>
        <p class="text-xs text-slate-400 mt-2">Most collected TV shows in user libraries on Trakt</p>
      </div>
      <div class="p-6">
        <form hx-post="/jobs/config/save" hx-target="#collected-shows-message" hx-swap="innerHTML" class="space-y-4">
          <input type="hidden" name="jobs.sync_interval" value="{{.Config.Jobs.SyncInterval}}" />

          <div class="flex items-center justify-between">
            <label class="flex items-center cursor-pointer">
              <input
                type="checkbox"
                name="jobs.collected_shows.enabled"
                {{if .Config.Jobs.CollectedShows.Enabled}}checked{{end}}
                class="w-5 h-5 text-blue-600 bg-slate-700 border-slate-600 rounded focus:ring-blue-500 cursor-pointer"
              />
              <span class="ml-3 text-base font-medium text-slate-300">Enable Job</span>
            </label>
          </div>

          <div>
            <label for="collected_shows_period" class="block text-sm font-medium text-slate-300 mb-2">
              Time Period
            </label>
            <select
              id="collected_shows_period"
              name="jobs.collected_shows.period"
              class="w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="weekly" {{if eq .Config.Jobs.CollectedShows.Period "weekly"}}selected{{end}}>Weekly</option>
              <option value="monthly" {{if eq .Config.Jobs.CollectedShows.Period "monthly"}}selected{{end}}>Monthly</option>
              <option value="yearly" {{if eq .Config.Jobs.CollectedShows.Period "yearly"}}selected{{end}}>Yearly</option>
              <option value="all" {{if eq .Config.Jobs.CollectedShows.Period "all"}}selected{{end}}>All Time</option>
            </select>
            <p class="text-xs text-slate-400 mt-1">Timeframe for collected shows</p>
          </div>

          <div>
            <label for="collected_shows_limit" class="block text-sm font-medium text-slate-300 mb-2">
              Content Limit
            </label>
            <input
              type="number"
              id="collected_shows_limit"
              name="jobs.collected_shows.limit"
              value="{{.Config.Jobs.CollectedShows.Limit}}"
              min="1"
              max="100"
              class="w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <p class="text-xs text-slate-400 mt-1">Number of shows to fetch (1-100)</p>
          </div>

          <!-- Advanced Settings Toggle -->
          <div class="border-t border-slate-700 pt-4">
            <button type="button" onclick="toggleAdvanced('collected-shows', this)" class="flex items-center justify-between w-full px-3 py-2 text-sm font-medium text-slate-300 hover:text-slate-100 hover:bg-slate-700/50 rounded-lg transition-colors">
              <span>Advanced Settings</span>
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <div id="collected-shows-advanced" class="hidden mt-4 space-y-4 bg-slate-900/50 p-4 rounded-lg border border-slate-700">
              <div>
                <label for="collected_shows_interval" class="block text-sm font-medium text-slate-300 mb-2">
                  Custom Sync Interval
                </label>
                <input
                  type="text"
                  id="collected_shows_interval"
                  name="jobs.collected_shows.sync_interval"
                  value="{{.Config.Jobs.CollectedShows.SyncInterval}}"
                  placeholder="Leave empty to use default"
                  class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <p class="text-xs text-slate-400 mt-1">Override default interval (e.g., 1h, 30m, 0 */2 * * *)</p>
              </div>
              
              <div>
                <label for="collected_shows_mode" class="block text-sm font-medium text-slate-300 mb-2">
                  Custom Mode
                </label>
                <select
                  id="collected_shows_mode"
                  name="jobs.collected_shows.mode"
                  class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  <option value="">Use Default</option>
                  <option value="direct" {{if eq .Config.Jobs.CollectedShows.Mode "direct"}}selected{{end}}>Direct (Radarr/Sonarr)</option>
                  <option value="jellyseerr" {{if eq .Config.Jobs.CollectedShows.Mode "jellyseerr"}}selected{{end}}>Jellyseerr</option>
                </select>
                <p class="text-xs text-slate-400 mt-1">Override default integration mode</p>
              </div>
            </div>
          </div>

          <div class="flex gap-2">
            <button
              type="submit"
              class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors"
            >
              Save
            </button>
            <button
              type="button"
              onclick="previewJob('collected-shows', this)"
              class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors"
            >
              Preview
            </button>
            <button
              type="button"
              onclick="triggerJob('collected-shows', this)"
              {{if not .Config.Jobs.CollectedShows.Enabled}}disabled{{end}}
              class="flex-1 px-4 py-2 bg-green-600 hover:bg-green-700 disabled:bg-slate-700 disabled:text-slate-500 disabled:cursor-not-allowed rounded-lg font-medium transition-colors"
            >
              Run Now
            </button>
          </div>
          <div id="collected-shows-message"></div>
        </form>
      </div>
    </div>

