{{define "jobs"}}
<div class="space-y-6">
  <!-- Information Box -->
  <div class="bg-blue-900/20 border border-blue-700/50 rounded-lg p-4">
    <div class="flex items-start">
      <svg class="w-5 h-5 text-blue-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
      </svg>
      <div>
        <h4 class="font-semibold text-blue-300 mb-1">About Jobs</h4>
        <p class="text-sm text-slate-300">
          Jobs automatically fetch content from Trakt and add them to Radarr/Sonarr based on the sync interval. 
          You can edit settings for each job individually and test them using "Run Now". 
          Existing content is automatically detected and skipped to avoid duplicates.
          {{if eq .Version "dev"}}<span class="font-semibold text-yellow-400">⚠️ Running in DEV mode - jobs will run in dry-run (no content will be added).</span>{{end}}
        </p>
      </div>
    </div>
  </div>

  <!-- Global Settings Section -->
  <div class="bg-slate-800/50 backdrop-blur rounded-lg p-6 border border-slate-700">
    <h2 class="text-2xl font-semibold text-slate-100 mb-6 flex items-center">
      <svg class="w-6 h-6 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      Global Settings
    </h2>

    <form hx-post="/jobs/config/save" hx-target="#global-message" hx-swap="innerHTML" class="space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label for="sync_interval" class="block text-sm font-medium text-slate-300 mb-2">
            Default Sync Interval <span class="text-red-400">*</span>
          </label>
          <input
            type="text"
            id="sync_interval"
            name="jobs.sync_interval"
            value="{{.Config.Jobs.SyncInterval}}"
            placeholder="1h"
            class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            required
          />
          <p class="text-xs text-slate-400 mt-1">How often jobs run by default (e.g., 1h, 30m, 0 */2 * * *)</p>
        </div>
        <div>
          <label for="default_mode" class="block text-sm font-medium text-slate-300 mb-2">
            Default Mode <span class="text-red-400">*</span>
          </label>
          <select
            id="default_mode"
            name="jobs.mode"
            class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            required
          >
            <option value="direct" {{if eq .Config.Jobs.Mode "direct"}}selected{{end}}>Direct (Radarr/Sonarr)</option>
            <option value="jellyseerr" {{if eq .Config.Jobs.Mode "jellyseerr"}}selected{{end}}>Jellyseerr</option>
          </select>
          <p class="text-xs text-slate-400 mt-1">Default integration mode for all jobs</p>
        </div>
      </div>
      <div class="flex items-end">
        <button
          type="submit"
          class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors"
        >
          Save Global Settings
        </button>
      </div>
      <div id="global-message"></div>
    </form>
  </div>

  <!-- Movie Jobs Section -->
  <div class="bg-slate-800/50 backdrop-blur rounded-lg p-6 border border-slate-700 mb-6">
    <h2 class="text-2xl font-semibold text-slate-100 mb-2 flex items-center">
      <svg class="w-6 h-6 mr-2 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path>
      </svg>
      Movie Jobs
    </h2>
    <p class="text-sm text-slate-400 mb-6">Automatically discover and add movies from Trakt to Radarr</p>
  </div>

  <!-- Movie Job Cards -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Trending Movies Card -->
    <div class="bg-slate-800/50 backdrop-blur rounded-lg border border-slate-700 overflow-hidden">
      <div class="bg-gradient-to-r from-yellow-900/50 to-slate-800/50 p-4 border-b border-slate-700">
        <h3 class="text-xl font-semibold text-slate-100 flex items-center">
          <svg class="w-6 h-6 mr-2 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
          </svg>
          Trending Movies
          <span class="ml-auto px-2 py-1 text-xs font-semibold rounded-full {{if .Config.Jobs.TrendingMovies.Enabled}}bg-green-500/20 text-green-400{{else}}bg-slate-600/50 text-slate-400{{end}}">
            {{if .Config.Jobs.TrendingMovies.Enabled}}ENABLED{{else}}DISABLED{{end}}
          </span>
        </h3>
        <p class="text-xs text-slate-400 mt-2">Movies currently being watched and talked about on Trakt</p>
      </div>
      <div class="p-6">
        <form hx-post="/jobs/config/save" hx-target="#trending-movies-message" hx-swap="innerHTML" class="space-y-4">
          <input type="hidden" name="jobs.sync_interval" value="{{.Config.Jobs.SyncInterval}}" />
          <input type="hidden" name="jobs.mode" value="{{.Config.Jobs.Mode}}" />
          <input type="hidden" name="jobs.trending_shows.enabled" value="{{if .Config.Jobs.TrendingShows.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.trending_shows.limit" value="{{.Config.Jobs.TrendingShows.Limit}}" />
          <input type="hidden" name="jobs.popular_movies.enabled" value="{{if .Config.Jobs.PopularMovies.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.popular_movies.limit" value="{{.Config.Jobs.PopularMovies.Limit}}" />
          <input type="hidden" name="jobs.popular_shows.enabled" value="{{if .Config.Jobs.PopularShows.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.popular_shows.limit" value="{{.Config.Jobs.PopularShows.Limit}}" />
          <input type="hidden" name="jobs.box_office.enabled" value="{{if .Config.Jobs.BoxOffice.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.box_office.limit" value="{{.Config.Jobs.BoxOffice.Limit}}" />

          <div class="flex items-center justify-between">
            <label class="flex items-center cursor-pointer">
              <input
                type="checkbox"
                name="jobs.trending_movies.enabled"
                {{if .Config.Jobs.TrendingMovies.Enabled}}checked{{end}}
                class="w-5 h-5 text-blue-600 bg-slate-700 border-slate-600 rounded focus:ring-blue-500 cursor-pointer"
              />
              <span class="ml-3 text-base font-medium text-slate-300">Enable Job</span>
            </label>
          </div>

          <div>
            <label for="trending_movies_limit" class="block text-sm font-medium text-slate-300 mb-2">
              Content Limit
            </label>
            <input
              type="number"
              id="trending_movies_limit"
              name="jobs.trending_movies.limit"
              value="{{.Config.Jobs.TrendingMovies.Limit}}"
              min="1"
              max="100"
              class="w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <p class="text-xs text-slate-400 mt-1">Number of movies to fetch (1-100)</p>
          </div>

          <!-- Advanced Settings Toggle -->
          <div class="border-t border-slate-700 pt-4">
            <button
              type="button"
              onclick="toggleAdvanced('trending-movies', this)"
              class="flex items-center justify-between w-full text-sm font-medium text-slate-300 hover:text-blue-400 transition-colors"
            >
              <span>Advanced Settings</span>
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <div id="trending-movies-advanced" class="hidden mt-4 space-y-4 bg-slate-900/50 p-4 rounded-lg border border-slate-700">
              <div>
                <label for="trending_movies_interval" class="block text-sm font-medium text-slate-300 mb-2">
                  Custom Sync Interval
                </label>
                <input
                  type="text"
                  id="trending_movies_interval"
                  name="jobs.trending_movies.sync_interval"
                  value="{{.Config.Jobs.TrendingMovies.SyncInterval}}"
                  placeholder="Leave empty to use default"
                  class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <p class="text-xs text-slate-400 mt-1">Override default interval (e.g., 1h, 30m, 0 */2 * * *)</p>
              </div>
              
              <div>
                <label for="trending_movies_mode" class="block text-sm font-medium text-slate-300 mb-2">
                  Custom Mode
                </label>
                <select
                  id="trending_movies_mode"
                  name="jobs.trending_movies.mode"
                  class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  <option value="">Use Default</option>
                  <option value="direct" {{if eq .Config.Jobs.TrendingMovies.Mode "direct"}}selected{{end}}>Direct (Radarr/Sonarr)</option>
                  <option value="jellyseerr" {{if eq .Config.Jobs.TrendingMovies.Mode "jellyseerr"}}selected{{end}}>Jellyseerr</option>
                </select>
                <p class="text-xs text-slate-400 mt-1">Override default integration mode</p>
              </div>
            </div>
          </div>

          <div class="flex gap-2">
            <button
              type="submit"
              class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors"
            >
              Save
            </button>
            <button
              type="button"
              onclick="previewJob('trending-movies', this)"
              class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors"
            >
              Preview
            </button>
            <button
              type="button"
              onclick="triggerJob('trending-movies', this)"
              {{if not .Config.Jobs.TrendingMovies.Enabled}}disabled{{end}}
              class="flex-1 px-4 py-2 bg-green-600 hover:bg-green-700 disabled:bg-slate-700 disabled:text-slate-500 disabled:cursor-not-allowed rounded-lg font-medium transition-colors"
            >
              Run Now
            </button>
          </div>
          <div id="trending-movies-message"></div>
        </form>
      </div>
    </div>

    <!-- Popular Movies Card -->
    <div class="bg-slate-800/50 backdrop-blur rounded-lg border border-slate-700 overflow-hidden">
      <div class="bg-gradient-to-r from-purple-900/50 to-slate-800/50 p-4 border-b border-slate-700">
        <h3 class="text-xl font-semibold text-slate-100 flex items-center">
          <svg class="w-6 h-6 mr-2 text-purple-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path>
          </svg>
          Popular Movies
          <span class="ml-auto px-2 py-1 text-xs font-semibold rounded-full {{if .Config.Jobs.PopularMovies.Enabled}}bg-green-500/20 text-green-400{{else}}bg-slate-600/50 text-slate-400{{end}}">
            {{if .Config.Jobs.PopularMovies.Enabled}}ENABLED{{else}}DISABLED{{end}}
          </span>
        </h3>
        <p class="text-xs text-slate-400 mt-2">Most popular movies on Trakt based on user ratings and views</p>
      </div>
      <div class="p-6">
        <form hx-post="/jobs/config/save" hx-target="#popular-movies-message" hx-swap="innerHTML" class="space-y-4">
          <input type="hidden" name="jobs.sync_interval" value="{{.Config.Jobs.SyncInterval}}" />
          <input type="hidden" name="jobs.trending_movies.enabled" value="{{if .Config.Jobs.TrendingMovies.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.trending_movies.limit" value="{{.Config.Jobs.TrendingMovies.Limit}}" />
          <input type="hidden" name="jobs.trending_shows.enabled" value="{{if .Config.Jobs.TrendingShows.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.trending_shows.limit" value="{{.Config.Jobs.TrendingShows.Limit}}" />
          <input type="hidden" name="jobs.popular_shows.enabled" value="{{if .Config.Jobs.PopularShows.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.popular_shows.limit" value="{{.Config.Jobs.PopularShows.Limit}}" />
          <input type="hidden" name="jobs.box_office.enabled" value="{{if .Config.Jobs.BoxOffice.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.box_office.limit" value="{{.Config.Jobs.BoxOffice.Limit}}" />

          <div class="flex items-center justify-between">
            <label class="flex items-center cursor-pointer">
              <input
                type="checkbox"
                name="jobs.popular_movies.enabled"
                {{if .Config.Jobs.PopularMovies.Enabled}}checked{{end}}
                class="w-5 h-5 text-blue-600 bg-slate-700 border-slate-600 rounded focus:ring-blue-500 cursor-pointer"
              />
              <span class="ml-3 text-base font-medium text-slate-300">Enable Job</span>
            </label>
          </div>

          <div>
            <label for="popular_movies_limit" class="block text-sm font-medium text-slate-300 mb-2">
              Content Limit
            </label>
            <input
              type="number"
              id="popular_movies_limit"
              name="jobs.popular_movies.limit"
              value="{{.Config.Jobs.PopularMovies.Limit}}"
              min="1"
              max="100"
              class="w-full px-4 py-2 bg-slate-900 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
            <p class="text-xs text-slate-400 mt-1">Number of movies to fetch (1-100)</p>
          </div>

          <!-- Advanced Settings Toggle -->
          <div class="border-t border-slate-700 pt-4">
            <button type="button" onclick="toggleAdvanced('popular-movies', this)" class="flex items-center justify-between w-full px-3 py-2 text-sm font-medium text-slate-300 hover:text-slate-100 hover:bg-slate-700/50 rounded-lg transition-colors">
              <span>Advanced Settings</span>
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <div id="popular-movies-advanced" class="hidden mt-4 space-y-4 bg-slate-900/50 p-4 rounded-lg border border-slate-700">
              <div>
                <label for="popular_movies_interval" class="block text-sm font-medium text-slate-300 mb-2">
                  Custom Sync Interval
                </label>
                <input
                  type="text"
                  id="popular_movies_interval"
                  name="jobs.popular_movies.sync_interval"
                  value="{{.Config.Jobs.PopularMovies.SyncInterval}}"
                  placeholder="Leave empty to use default"
                  class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <p class="text-xs text-slate-400 mt-1">Override default interval (e.g., 1h, 30m, 0 */2 * * *)</p>
              </div>
              
              <div>
                <label for="popular_movies_mode" class="block text-sm font-medium text-slate-300 mb-2">
                  Custom Mode
                </label>
                <select
                  id="popular_movies_mode"
                  name="jobs.popular_movies.mode"
                  class="w-full px-4 py-2 bg-slate-800 border border-slate-600 rounded-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  <option value="">Use Default</option>
                  <option value="direct" {{if eq .Config.Jobs.PopularMovies.Mode "direct"}}selected{{end}}>Direct (Radarr/Sonarr)</option>
                  <option value="jellyseerr" {{if eq .Config.Jobs.PopularMovies.Mode "jellyseerr"}}selected{{end}}>Jellyseerr</option>
                </select>
                <p class="text-xs text-slate-400 mt-1">Override default integration mode</p>
              </div>
            </div>
          </div>

          <div class="flex gap-2">
            <button
              type="submit"
              class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors"
            >
              Save
            </button>
            <button
              type="button"
              onclick="previewJob('popular-movies', this)"
              class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-medium transition-colors"
            >
              Preview
            </button>
            <button
              type="button"
              onclick="triggerJob('popular-movies', this)"
              {{if not .Config.Jobs.PopularMovies.Enabled}}disabled{{end}}
              class="flex-1 px-4 py-2 bg-green-600 hover:bg-green-700 disabled:bg-slate-700 disabled:text-slate-500 disabled:cursor-not-allowed rounded-lg font-medium transition-colors"
            >
              Run Now
            </button>
          </div>
          <div id="popular-movies-message"></div>
        </form>
      </div>
    </div>

    <!-- Box Office Card -->
    <div class="bg-slate-800/50 backdrop-blur rounded-lg border border-slate-700 overflow-hidden">
      <div class="bg-gradient-to-r from-green-900/50 to-slate-800/50 p-4 border-b border-slate-700">
        <h3 class="text-xl font-semibold text-slate-100 flex items-center">
          <svg class="w-6 h-6 mr-2 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path>
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path>
          </svg>
          Box Office
          <span class="ml-auto px-2 py-1 text-xs font-semibold rounded-full {{if .Config.Jobs.BoxOffice.Enabled}}bg-green-500/20 text-green-400{{else}}bg-slate-600/50 text-slate-400{{end}}">
            {{if .Config.Jobs.BoxOffice.Enabled}}ENABLED{{else}}DISABLED{{end}}
          </span>
        </h3>
        <p class="text-xs text-slate-400 mt-2">Top grossing movies at the box office</p>
      </div>
      <div class="p-6">
        <form hx-post="/jobs/config/save" hx-target="#box-office-message" hx-swap="innerHTML" class="space-y-4">
          <input type="hidden" name="jobs.sync_interval" value="{{.Config.Jobs.SyncInterval}}" />
          <input type="hidden" name="jobs.trending_movies.enabled" value="{{if .Config.Jobs.TrendingMovies.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.trending_movies.limit" value="{{.Config.Jobs.TrendingMovies.Limit}}" />
          <input type="hidden" name="jobs.trending_shows.enabled" value="{{if .Config.Jobs.TrendingShows.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.trending_shows.limit" value="{{.Config.Jobs.TrendingShows.Limit}}" />
          <input type="hidden" name="jobs.popular_movies.enabled" value="{{if .Config.Jobs.PopularMovies.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.popular_movies.limit" value="{{.Config.Jobs.PopularMovies.Limit}}" />
          <input type="hidden" name="jobs.popular_shows.enabled" value="{{if .Config.Jobs.PopularShows.Enabled}}on{{end}}" />
          <input type="hidden" name="jobs.popular_shows.limit" value="{{.Config.Jobs.PopularShows.Limit}}" />
          <input type="hidden" name="jobs.box_office.limit" value="{{.Config.Jobs.BoxOffice.Limit}}" />

          <div class="flex items-center justify-between">
            <label class="flex items-center cursor-pointer">
              <input
                type="checkbox"
                name="jobs.box_office.enabled"
                {{if .Config.Jobs.BoxOffice.Enabled}}checked{{end}}
                class="w-5 h-5 text-blue-600 bg-slate-700 border-slate-600 rounded focus:ring-blue-500 cursor-pointer"
              />
              <span class="ml-3 text-base font-medium text-slate-300">Enable Job</span>
            </label>
          </div>

          <div class="bg-blue-900/20 border border-blue-700/50 rounded-lg p-3">
            <p class="text-sm text-slate-300">
              <span class="font-semibold text-blue-400">Note:</span> Box Office fetches the top 10 highest grossing movies from Trakt.
            </p>
          </div>

          <!-- Advanced Settings Toggle -->
          <div class="border-t border-slate-700 pt-4">
            <button type="button" onclick="toggleAdvanced('box-office', this)" class="flex items-center justify-between w-full px-3 py-2 text-sm font-medium text-slate-300 hover:text-slate-100 hover:bg-slate-700/50 rounded-lg transition-colors">
              <span>Advanced Settings</span>
              <svg class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <div id="box-office-advanced" class="hidden mt-4 space-y-4 bg-slate-900/50 p-4 rounded-lg border border-slate-700">
              <div>
                <label for="box_office_interval" class="block text-sm font-medium text-slate-300 mb-2">
                  Custom Sync Interval
                </label>
                <input
                  type="text"
                  id="box_office_interval"
                  name="jobs.box_office.sync_interval"
                  value="{{.Config.Jobs.BoxOffice.SyncInterval}}"
