---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';

const isV1 = import.meta.env.BASE_URL.startsWith('/v1');
---

<div class="versioned-site-title">
	<SiteTitle />
	<label class="sr-only" for="docs-version">Documentation version</label>
	<select id="docs-version" class="version-switcher" aria-label="Documentation version">
		<option value="https://blockbusterr.dev/" selected={!isV1}>v2 stable</option>
		<option value="https://blockbusterr.dev/v1/" selected={isV1}>v1 archive</option>
	</select>
</div>

<script>
	const selector = document.querySelector('.version-switcher');
	selector?.addEventListener('change', (event) => {
		window.location.assign(event.currentTarget.value);
	});
</script>

<style>
	.versioned-site-title {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
	}

	.version-switcher {
		flex: none;
		max-width: 10.5rem;
		height: 1.875rem;
		padding: 0 1.75rem 0 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-xs);
		cursor: pointer;
	}

	.version-switcher:hover {
		border-color: var(--sl-color-gray-4);
		color: var(--sl-color-white);
	}

	.version-switcher:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	@media (max-width: 30rem) {
		.version-switcher {
			max-width: 4rem;
		}
	}
</style>
